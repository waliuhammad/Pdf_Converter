{
  "compilerOptions": {
    "target": "ES2022",
    // TypeScript 7 removed node10 resolution, which is what this was set to, so
    // `npm run build` failed outright. node16 replaces it but then rejects
    // @google/genai — an ESM package that this CommonJS build would `require`.
    // The compiled output would not have run either way.
    //
    // tsx already runs the service in development and handles that interop, so
    // it runs it in production too and tsc is only a typechecker now.
    //
    // Vercel compiles src/ with this config, though, and package.json says
    // "commonjs": with "preserve" it emitted import statements into .js files
    // and Node refused to load them ("Failed to load the ES module"). So the
    // output is CommonJS; @google/genai ships a CommonJS build for require.
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noEmit": true,
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}